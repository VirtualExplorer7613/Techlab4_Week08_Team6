CompileFlags:
  Add:
    - "-m64"
    - "--target=x86_64-pc-windows-msvc"
    - "-fms-extensions"
    - "-fms-compatibility"
    - "-fms-compatibility-version=19.41"
    - "-std=c++20"
    - "-DWIN32_LEAN_AND_MEAN"
    - "-DNOMINMAX"
    - "-DUNICODE"
    - "-D_UNICODE"
    - "-DENGINE_PLATFORM_WINDOWS"
    - "-DENGINE_DEBUG"
    - "-D_DEBUG"
    - "-imsvc"
    - "C:/Program Files/Microsoft Visual Studio/18/Insiders/VC/Tools/MSVC/14.51.36231/include"
    - "-imsvc"
    - "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/ucrt"
    - "-imsvc"
    - "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/shared"
    - "-imsvc"
    - "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/um"
    - "-imsvc"
    - "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/winrt"
    - "-imsvc"
    - "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/cppwinrt"
    - "-I"
    - "Source"
    - "-I"
    - "Source/Runtime"
    - "-I"
    - "Source/ThirdParty/ImGui"
    - "-I"
    - "Source/ThirdParty/ImGui/backends"
    - "-I"
    - "Source/ThirdParty/stb"
    - "-I"
    - "Source/ThirdParty/json"
    - "-I"
    - "Resources/Shader"
    - "-I"
    - "Source/Programs"

Diagnostics:
  Suppress:
    - "pragma_pack"
    - "unknown_warning_option"
