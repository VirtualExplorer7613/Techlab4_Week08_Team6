{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Debug (VS18 MSBuild)",
            "type": "process",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Insiders\\MSBuild\\Current\\Bin\\amd64\\MSBuild.exe",
            "args": [
                "Hitori.slnx",
                "/p:Configuration=Debug",
                "/p:Platform=x64",
                "/m",
                "/v:minimal"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Release (VS18 MSBuild)",
            "type": "process",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Insiders\\MSBuild\\Current\\Bin\\amd64\\MSBuild.exe",
            "args": [
                "Hitori.slnx",
                "/p:Configuration=Release",
                "/p:Platform=x64",
                "/m",
                "/v:minimal"
            ],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true,
                "clear": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run HitoriEditor Exe",
            "type": "process",
            "command": "${workspaceFolder}/Build/Bin/Debug-windows-x86_64/HitoriEditor.exe",
            "args": [],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "never"
            },
            "problemMatcher": []
        },
        {
            "label": "Generate Solution (Premake)",
            "type": "shell",
            "command": ".\\Setup\\premake5.exe vs2026",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        }
    ]
}
